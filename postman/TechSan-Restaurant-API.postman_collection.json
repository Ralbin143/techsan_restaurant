{
  "info": {
    "name": "TechSan Restaurant API",
    "description": "REST API v1 collection for TechSan Restaurant ERP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000/api/v1" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', json.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', json.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@techsan.com\",\n  \"password\": \"Admin@123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/refresh"
          }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/auth/me" }
        },
        {
          "name": "Guest Session",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": \"TABLE_ID\",\n  \"branchId\": \"BRANCH_ID\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/auth/guest-session"
          }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tableId\": \"TABLE_ID\",\n  \"source\": \"waiter\",\n  \"items\": [{ \"menuItemId\": \"ITEM_ID\", \"quantity\": 2 }]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Kitchen Queue",
          "request": { "method": "GET", "url": "{{baseUrl}}/orders/kitchen" }
        },
        {
          "name": "Update Status",
          "request": {
            "method": "PATCH",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"preparing\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/orders/:id/status"
          }
        }
      ]
    },
    {
      "name": "Tables",
      "item": [
        {
          "name": "Live Monitor",
          "request": { "method": "GET", "url": "{{baseUrl}}/tables/live" }
        },
        {
          "name": "Get by QR Token",
          "request": { "method": "GET", "url": "{{baseUrl}}/tables/qr/:token" }
        }
      ]
    },
    {
      "name": "Menu",
      "item": [
        {
          "name": "Public Menu",
          "request": { "method": "GET", "url": "{{baseUrl}}/menu/public/:restaurantId" }
        },
        {
          "name": "List Items",
          "request": { "method": "GET", "url": "{{baseUrl}}/menu/items" }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Process Payment",
          "request": {
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"ORDER_ID\",\n  \"method\": \"cash\",\n  \"amount\": 500\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/payments"
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "Daily Sales",
          "request": { "method": "GET", "url": "{{baseUrl}}/reports/daily-sales" }
        },
        {
          "name": "Sales Forecast",
          "request": { "method": "GET", "url": "{{baseUrl}}/reports/forecast" }
        }
      ]
    },
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/health" }
    }
  ]
}
