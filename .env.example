# ─── Application ─────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
API_BASE_URL=http://localhost:4000
ADMIN_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── MongoDB ─────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/techsan_restaurant

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_GUEST_EXPIRES_IN=2h

# ─── Storage ─────────────────────────────────────────────────
STORAGE_DRIVER=local
# local
UPLOAD_DIR=./uploads
# s3
AWS_REGION=ap-south-1
AWS_S3_BUCKET=techsan-restaurant
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ─── Firebase (Push Notifications) ───────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Email (OTP / Forgot Password) ───────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@techsan.com

# ─── Redis (optional – rate limit / socket adapter) ──────────
REDIS_URL=redis://localhost:6379

# ─── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200

# ─── AI / Forecasting (optional) ─────────────────────────────
OPENAI_API_KEY=
